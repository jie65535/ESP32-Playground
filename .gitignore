.pio/
components/
.venv/
__pycache__/
*.pyc
*.map
.vscode/
sdkconfig
sdkconfig.old
sdkconfig.*
!sdkconfig.defaults
managed_components/

# The vendor board package is a large local reference archive.
# Keep its README tracked, but do not commit PDFs, ZIPs, EXEs, images,
# CAD files or other binary assets into the normal Git history.
docs/vendor/*
!docs/vendor/README.md

# Local external datasheets; keep vendor PDFs out of Git history.
docs/datasheets/*

# Original BDF files are kept locally for regeneration; generated subsets are tracked.
tools/vendor-fonts/*

# Local credentials and captures. Never commit real network settings.
include/secrets.local.h
.env
.env.*
*.local
*.secret
*.pem
*.key
*.p12
captures/
logs/
artifacts/
